{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "search_calls": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "web_search",
              "manual",
              "search_report"
            ]
          }
        },
        "required": [
          "doc_id",
          "title",
          "reason",
          "origin"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "search_calls",
    "candidates"
  ],
  "additionalProperties": false
}
