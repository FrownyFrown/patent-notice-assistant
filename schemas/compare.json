{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "yes",
              "partial",
              "no"
            ]
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "component_id",
          "doc_id",
          "verdict",
          "paragraphs",
          "quote",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "matrix"
  ],
  "additionalProperties": false
}
